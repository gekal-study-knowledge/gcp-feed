# Firebase Web SDK 設定 (公開可能な値。GitHub Actions では Secrets 経由で注入)
# Firebase コンソールで gcp-feed プロジェクトを作成し、Web アプリを追加して
# 表示される値をコピーする。このファイルを .env.local にコピーして使う。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=gcp-feed.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=gcp-feed
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gcp-feed.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
